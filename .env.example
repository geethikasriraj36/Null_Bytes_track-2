# copy to .env and fill in. Never commit .env
AEGIS_MODEL=groq/llama-3.3-70b-versatile      # litellm model string; free Groq key: console.groq.com
AEGIS_JUDGE_MODEL=groq/llama-3.1-8b-instant   # cheap, high free quota
GROQ_API_KEY=                      # or GEMINI_API_KEY / OPENAI_API_KEY etc. (match AEGIS_MODEL)
AEGIS_HMAC_KEY=change-me-to-a-random-string
AEGIS_CONFIG=configs/7_full.yaml
AEGIS_AUDIT=logs/audit.jsonl
AEGIS_LLM_TIMEOUT=60               # seconds per LLM call (judge uses half)
