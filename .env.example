# copy to .env and fill in. Never commit .env
AEGIS_MODEL=gpt-4o-mini            # litellm model string for your provider
AEGIS_JUDGE_MODEL=gpt-4o-mini      # can be a cheaper model
OPENAI_API_KEY=                    # or ANTHROPIC_API_KEY / GEMINI_API_KEY etc.
AEGIS_HMAC_KEY=change-me-to-a-random-string
AEGIS_CONFIG=configs/7_full.yaml
AEGIS_AUDIT=logs/audit.jsonl
